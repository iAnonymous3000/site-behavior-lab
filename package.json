{
  "name": "site-behavior-lab",
  "version": "0.3.0",
  "description": "Evidence-first, reproducible web behavior scans with privacy-reduced reports.",
  "homepage": "https://sitebehavior.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iAnonymous3000/site-behavior-lab.git"
  },
  "bugs": {
    "url": "https://github.com/iAnonymous3000/site-behavior-lab/issues"
  },
  "keywords": [
    "web-transparency",
    "privacy",
    "trackers",
    "browser-automation",
    "playwright",
    "research"
  ],
  "license": "AGPL-3.0-or-later",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "build:pages": "node scripts/build-github-pages.mjs",
    "build:schema": "node scripts/build-schema.mjs",
    "cf:bucket:create": "wrangler r2 bucket create site-behavior-lab-reports",
    "cf:container:deploy": "node scripts/deploy-container.mjs",
    "cf:container:staging:deploy": "node scripts/deploy-container.mjs --config wrangler.container.staging.jsonc",
    "cf:container:staging:verify": "node scripts/deploy-container.mjs --check --config wrangler.container.staging.jsonc",
    "cf:container:watch-staging:deploy": "node scripts/deploy-container.mjs --config wrangler.container.watch-staging.jsonc",
    "cf:container:watch-staging:verify": "node scripts/deploy-container.mjs --check --config wrangler.container.watch-staging.jsonc",
    "cf:container:verify": "node scripts/deploy-container.mjs --check",
    "cf:r2-delete-canary:deploy": "wrangler deploy -c wrangler.r2-delete-canary.jsonc",
    "cf:typecheck": "tsc -p tsconfig.cloudflare.json --noEmit",
    "lists:brave": "node scripts/fetch-brave-lists.mjs",
    "lists:verify": "node scripts/verify-adblock-engine.mjs",
    "supply-chain:third-party:check": "node scripts/third-party-inventory.mjs --check",
    "supply-chain:reviews:sync": "node scripts/third-party-reviews.mjs --sync",
    "supply-chain:reviews:check": "node scripts/third-party-reviews.mjs --check",
    "release:readiness": "node scripts/release-readiness.mjs --report",
    "release:readiness:check": "node scripts/release-readiness.mjs --check",
    "check": "npm run typecheck && npm run cf:typecheck && npm run test:unit && npm run build",
    "corpus:pagegraph": "tsc -p tsconfig.test.json && node .unit-test-dist/lib/pagegraph-corpus-cli.js",
    "corpus:audit-neutrality": "node scripts/run-schema-cli.mjs corpus-neutrality",
    "corpus:stats": "node scripts/build-corpus-stats.mjs",
    "reports:manifest": "node scripts/build-static-report-manifest.mjs",
    "reports:publication-artifact": "node scripts/report-publication-artifact.mjs",
    "reports:publication-archive": "node scripts/report-publication-archive.mjs",
    "reports:prune": "node scripts/prune-static-reports.mjs",
    "corrections:verify-history": "node scripts/run-schema-cli.mjs corrections-ledger-history",
    "scan:ci": "node scripts/run-ci-scan.mjs",
    "scan:featured": "node scripts/run-featured-scans.mjs",
    "start": "next start",
    "test:smoke:static": "node scripts/smoke-static-site.mjs",
    "test:smoke:docker": "node scripts/smoke-docker.mjs",
    "test:smoke:scanner-fidelity": "node scripts/smoke-scanner-fidelity.mjs",
    "test:smoke:scanner": "node scripts/smoke-deployed-scanner.mjs",
    "test:smoke:production-synthetic": "node scripts/smoke-production-synthetic.mjs",
    "test:smoke:production-r2-delete": "node scripts/smoke-production-r2-delete.mjs",
    "test:smoke:durable-job-replay": "node scripts/smoke-durable-job-replay.mjs",
    "test:smoke:encrypted-watches": "node scripts/smoke-encrypted-watches.mjs",
    "toolchain:canary": "node scripts/run-schema-cli.mjs toolchain-canary",
    "wasm:verify-reproducibility": "node scripts/verify-wasm-reproducibility.mjs --verify",
    "test:unit": "rm -rf .unit-test-dist && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .unit-test-dist/lib/*.test.js",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "reports:remediation-inventory": "node scripts/remediation-inventory.mjs",
    "reports:remediate": "node scripts/run-schema-cli.mjs remediate-reports",
    "reports:aggregate-v2-shadow": "node scripts/run-schema-cli.mjs aggregate-v2-shadow",
    "reports:verify-v2-shadow": "node scripts/run-schema-cli.mjs verify-v2-shadow",
    "release:evidence": "node scripts/release-evidence.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "playwright": "1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tldts": "7.4.9"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "ajv": "8.20.0",
    "miniflare": "4.20260722.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.114.0"
  }
}
