{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-behavior-lab-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  // No workers.dev alias: the production scanner is the Containers deployment at
  // scan.sitebehavior.org, and this legacy Browser Run worker must not stay
  // reachable as an ungated side door (its DNS preflight cannot pin the
  // browser's eventual connection). Deploying with this config removes the
  // workers.dev route; the live legacy deployment should be deleted outright.
  "workers_dev": false,
  "upload_source_maps": false,
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS_KV",
      "id": "29a74d68b2284afe9f441d2278da224a"
    }
  ],
  "vars": {
    "SITE_BEHAVIOR_LAB_ALLOWED_ORIGIN": "*",
    // GATED by default since the 2026-07-09 security review: the public scanner
    // is the Containers deployment (wrangler.container.jsonc), which verifies
    // Turnstile and pins connections. This Browser Run worker performs only a
    // DNS preflight (no connect-time pinning), so an open deployment of it is a
    // DNS-rebinding risk. To run a gated instance, keep both flags "0" and set
    // the SITE_BEHAVIOR_LAB_SCAN_ACCESS_TOKEN secret. Opening it back up
    // requires flipping BOTH flags to "1", which is an explicit acceptance of
    // the documented rebinding limitation.
    "SITE_BEHAVIOR_LAB_ALLOW_UNAUTHENTICATED_SCANS": "0",
    "SITE_BEHAVIOR_LAB_ACCEPT_BROWSER_RUN_DNS_REBINDING_RISK": "0",
    "SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_MINUTE": "6",
    "SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_DAY": "120",
    "SITE_BEHAVIOR_LAB_SCANNER_EGRESS": "cloudflare-browser-run"
  }
}
