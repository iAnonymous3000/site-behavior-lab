  "design": {
    "sampling": "convenience",
    "samplingFrame": "calibration/pixel-events-pilot-2026-07-28/frame.json",
    "samplingFrameDigest": "a39983ea322eab18cd4fbbca5cad2c6608eb1a8752c8a4e0a882410ad275a1ca",
    "selectionProtocol": "Twelve sites chosen as likely pixel carriers (consumer retail and direct-to-consumer commerce, where Meta/TikTok/X advertising pixels are common) and twelve chosen as hard negatives (sites that do carry third-party requests, so an absent label is not trivially explained by an empty request log, but that are not consumer advertising properties). Strata were fixed before any scan ran and before any evidence was seen. The stratum is a DESIGN variable only: it is never used as, and never shown to, the reference label. Every listed case is attempted and none is replaced, so a site that blocks the scanner becomes a censored case rather than a silent substitution.",
    "referenceProtocol": "Two independent automated labelers, each a separate language-model agent with no shared context, received an identical blinded packet per case containing only the visit's distinct recorded requests (method, host, path, count) and an exact endpoint-matching label definition. The detector's own pixel-events output, the case's design stratum, and all report headline and finding copy were withheld, so the reference is blinded to the prediction. Labelers were instructed not to read repository files, because an unblinded artifact was present on disk. THESE ARE AUTOMATED LABELERS, NOT HUMAN EXPERTS: this pilot validates the calibration pipeline, and a held-out study intended to support published rates requires human reference labeling.",
    "referenceProtocolDigest": "f8cf20b3e679996c7ace56fb875b748c2d1cc1ecd1de58c0f53ab8c9b6b3a655",
    "adjudicationProtocol": "Any case where the two labelers disagreed would be sent to a third independent agent, which received the same blinded evidence plus both recorded rationales without attribution, and decided the case itself. In this pilot the two labelers agreed on all 15 labeled cases, so no adjudication was invoked.",
    "adjudicationProtocolDigest": "f4c9dbc6b8ec75d7a9f9815b80b96881074dd835d2e0b26d1bdacfeb1856f800",
    "independentUnits": true,
    "predictionBlindedToReference": true,
    "referenceBlindedToPrediction": true
  },
