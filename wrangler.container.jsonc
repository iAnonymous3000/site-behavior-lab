{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Full Node/Playwright scanner (live Shields) on Cloudflare Containers.
  // Deployed separately from wrangler.jsonc (the Browser Run GPC worker) so the
  // existing live worker is untouched. Runbook: docs/deploy-cloudflare-containers.md
  "name": "site-behavior-lab-scanner",
  "main": "cloudflare/container-worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  // Keep Worker/container invocation logs available after every repo-driven
  // deployment. Dashboard-only observability is reset when Wrangler uploads a
  // version unless the desired state is committed here.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Single ingress: the custom domain (scan.sitebehavior.org). The Turnstile and
  // rate-limit gates live in container-worker.ts so a workers.dev alias would be
  // equally gated, but keeping one hostname means zone-level protections (WAF,
  // analytics, future rules) can never be sidestepped by the alias.
  "workers_dev": false,
  "vars": {
    // Browser CORS allow-list for the scan API, forwarded into the container by
    // container-worker.ts. Pin it to the Pages origin that calls this scanner;
    // use "*" for an intentionally open scanner (the scan API uses no cookies).
    "SITE_BEHAVIOR_LAB_ALLOWED_ORIGIN": "https://sitebehavior.org",

    // Privacy-safe aggregate product observability. Keep disabled until the
    // public privacy/methodology disclosure, event instrumentation, dashboard
    // queries, WAF limit, and activation review in
    // docs/privacy-safe-observability.md are complete. Missing bindings/config
    // fail closed; there is no raw-log fallback.
    "SITE_BEHAVIOR_LAB_AGGREGATE_METRICS": "0",

    // Public scanner (see docs/go-live-public-scanner.md): open to unauthenticated
    // visitors. container-worker.ts enforces Turnstile (the TURNSTILE_SECRET_KEY
    // secret) plus the atomic Durable Object quota before any request reaches
    // the container's browser. The scanner stays GATED until the
    // SITE_BEHAVIOR_LAB_SCAN_ACCESS_TOKEN secret is removed, these vars are inert
    // while that token is set.
    "SITE_BEHAVIOR_LAB_ALLOW_UNAUTHENTICATED_SCANS": "1",
    "SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_MINUTE": "6",
    "SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_DAY": "120",

    // The hourly production synthetic uses the distinct Worker-only
    // SITE_BEHAVIOR_LAB_SYNTHETIC_MONITOR_TOKEN secret. It bypasses Turnstile
    // only for that authenticated request and never closes public ingress.

    // Public ScanReport v2/r2 is the durable production producer. Consent
    // readback is a hard prerequisite; a bad gate/build/store configuration
    // fails scans closed instead of silently falling back to v1. Private
    // shadow emission remains off during normal public operation.
    "SITE_BEHAVIOR_LAB_CONSENT_VERIFICATION": "1",
    "SITE_BEHAVIOR_LAB_PUBLIC_R2_REPORTS": "1",
    "SITE_BEHAVIOR_LAB_R2_BUCKET": "site-behavior-lab-reports",
    "SITE_BEHAVIOR_LAB_R2_PREFIX": "reports/",

    // Disabled ship gate. Before changing this to "1", configure the distinct
    // SITE_BEHAVIOR_LAB_DURABLE_JOBS_KEY (Worker-only, canonical 32-byte
    // base64url) and SITE_BEHAVIOR_LAB_DURABLE_JOBS_INTERNAL_TOKEN secrets, then
    // pass both live replay canaries in docs/go-live-public-scanner.md. The
    // coordinator origin is non-secret and is forwarded into the container.
    "SITE_BEHAVIOR_LAB_DURABLE_JOBS": "0",
    "SITE_BEHAVIOR_LAB_DURABLE_JOBS_COORDINATOR_URL": "https://scan.sitebehavior.org",

    // Independent post-durability rollout gate. Keep this at "0" until
    // durable jobs are live and proven. When enabled, shard zero reuses the
    // default singleton and shards one/two are named instances, so count 3
    // consumes exactly the max_instances: 3 ceiling below (not 3 + 1).
    "SITE_BEHAVIOR_LAB_CONTAINER_SHARDING": "0",
    "SITE_BEHAVIOR_LAB_CONTAINER_SHARD_COUNT": "3",

    // Independent post-durability gate for encrypted seven-day scheduled
    // rescans. Enabling requires a distinct Worker-only current watch key; an
    // optional previous key supports rotation across the bounded 30-day TTL.
    // Neither key is forwarded into the Node container.
    "SITE_BEHAVIOR_LAB_ENCRYPTED_WATCHES": "0",

    // Durable job/status metadata lives for 75 minutes. Keep the public report
    // alive for at least the same interval so a lost status response can recover
    // the committed report instead of fabricating expiry.
    "SITE_BEHAVIOR_LAB_REPORT_MIN_SURVIVAL_MS": "4500000",

    // Forwarded into the Node container. The deployed smoke test requires the
    // effective launch state to be "enabled" in /api/health.
    "SITE_BEHAVIOR_LAB_CHROMIUM_SANDBOX": "1"
  },

  // Stores only fixed event-name/dimension enums plus count=1. It never
  // receives a target URL/domain, report id, query, evidence, cookie, or
  // user/session identifier. Writes remain disabled by the flag above.
  "analytics_engine_datasets": [
    {
      "binding": "AGGREGATE_METRICS",
      "dataset": "site_behavior_lab_aggregate_metrics"
    }
  ],

  "containers": [
    {
      "class_name": "ScannerContainer",
      // Builds the repo Dockerfile (Next.js + Playwright Chromium).
      "image": "./Dockerfile",
      // Replaced by scripts/deploy-container.mjs from WORKERS_CI_COMMIT_SHA
      // (or the exact local HEAD). The Dockerfile rejects the placeholder, so
      // a raw wrangler deploy can never publish unverifiable build provenance.
      "image_vars": {
        "SITE_BEHAVIOR_LAB_BUILD_COMMIT": "__SITE_BEHAVIOR_LAB_BUILD_COMMIT__"
      },
      // standard-2 = 6 GiB RAM / 12 GB disk: Chromium needs ~2 GB and the
      // Playwright image (~2-3 GB) must fit the instance disk. standard-1 is the
      // floor; lite/basic are too small. See docs/deploy-cloudflare-containers.md.
      "instance_type": "standard-2",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCANNER", "class_name": "ScannerContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScannerContainer"] }]
}
