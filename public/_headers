# Security headers for the static Cloudflare Pages front door
# (https://sitebehavior.org). The Node/container origin gets the equivalent
# set from next.config.mjs `headers()`, which a static export never serves;
# Cloudflare Pages reads this file from the build output instead (public/ is
# copied into out/). Self-hosts that point the static UI at a different scan
# origin must add that origin to connect-src.
#
# CSP notes, mirroring the Node origin's policy:
# - 'unsafe-inline' script/style: Next emits inline bootstrap scripts plus the
#   pre-paint theme script; per-request nonces are impossible in a static
#   export. React output escaping remains the primary XSS defense.
# - challenges.cloudflare.com: Turnstile widget script + challenge iframe for
#   the scan form.
# - scan.sitebehavior.org: the scan API (health, scans, report JSON).
# - static.cloudflareinsights.com / cloudflareinsights.com: the Cloudflare Web
#   Analytics beacon Pages injects when enabled on the project.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' https://scan.sitebehavior.org https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), serial=(), usb=()

# The scan landing page receives client-only fragment prefills. Do not retain
# its response in shared or browser caches if a legacy query-prefill link is
# encountered and then scrubbed by the client.
/
  Cache-Control: no-store

# Next's static image routes are extensionless PNG files. Declare their real
# media type explicitly so Pages does not serve every social card as
# application/octet-stream under nosniff.
/opengraph-image
  Content-Type: image/png

/twitter-image
  Content-Type: image/png

# The scanner-origin status page reads this public, non-sensitive receipt to
# compare the deployed revisions. Wildcard read access is safe because the
# response is already public and the request carries no credentials.
/deployment.json
  Access-Control-Allow-Origin: *

/reports/*/opengraph-image
  Content-Type: image/png

/reports/*/twitter-image
  Content-Type: image/png

# Frozen schema bytes cannot carry post-publication corrections. Publish a
# machine-discoverable companion link on every current schema response instead.
/scan-report.schema.json
  Link: </methodology/#schema-errata>; rel="describedby"

/schemas/scan-report.v2.r1.schema.json
  Link: </methodology/#schema-errata>; rel="describedby"

/schemas/scan-report.v2.r2.schema.json
  Link: </methodology/#schema-errata>; rel="describedby"
