{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Full Node/Playwright scanner (live Shields) on Cloudflare Containers.
  // Deployed separately from wrangler.jsonc (the Browser Run GPC worker) so the
  // existing live worker is untouched. Runbook: docs/deploy-cloudflare-containers.md
  "name": "site-behavior-lab-scanner",
  "main": "cloudflare/container-worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  // Keep Worker/container invocation logs available after every repo-driven
  // deployment. Dashboard-only observability is reset when Wrangler uploads a
  // version unless the desired state is committed here.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Single ingress: the custom domain (scan.sitebehavior.org). The Turnstile and
  // rate-limit gates live in container-worker.ts so a workers.dev alias would be
  // equally gated, but keeping one hostname means zone-level protections (WAF,
  // analytics, future rules) can never be sidestepped by the alias.
  "workers_dev": false,
  "vars": {
    // Browser CORS allow-list for the scan API, forwarded into the container by
    // container-worker.ts. Pin it to the Pages origin that calls this scanner;
    // use "*" for an intentionally open scanner (the scan API uses no cookies).
    "SITE_BEHAVIOR_LAB_ALLOWED_ORIGIN": "https://sitebehavior.org",

    // Public scanner (see docs/go-live-public-scanner.md): open to unauthenticated
    // visitors. container-worker.ts enforces Turnstile (the TURNSTILE_SECRET_KEY
    // secret) plus the atomic Durable Object quota before any request reaches
    // the container's browser. The scanner stays GATED until the
    // SITE_BEHAVIOR_LAB_SCAN_ACCESS_TOKEN secret is removed, these vars are inert
    // while that token is set.
    "SITE_BEHAVIOR_LAB_ALLOW_UNAUTHENTICATED_SCANS": "1",
    "SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_MINUTE": "6",
    "SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_DAY": "120",

    // Forwarded into the Node container. The deployed smoke test requires the
    // effective launch state to be "enabled" in /api/health.
    "SITE_BEHAVIOR_LAB_CHROMIUM_SANDBOX": "1"
  },

  "containers": [
    {
      "class_name": "ScannerContainer",
      // Builds the repo Dockerfile (Next.js + Playwright Chromium).
      "image": "./Dockerfile",
      // Replaced by scripts/deploy-container.mjs from WORKERS_CI_COMMIT_SHA
      // (or the exact local HEAD). The Dockerfile rejects the placeholder, so
      // a raw wrangler deploy can never publish unverifiable build provenance.
      "image_vars": {
        "SITE_BEHAVIOR_LAB_BUILD_COMMIT": "__SITE_BEHAVIOR_LAB_BUILD_COMMIT__"
      },
      // standard-2 = 6 GiB RAM / 12 GB disk: Chromium needs ~2 GB and the
      // Playwright image (~2-3 GB) must fit the instance disk. standard-1 is the
      // floor; lite/basic are too small. See docs/deploy-cloudflare-containers.md.
      "instance_type": "standard-2",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCANNER", "class_name": "ScannerContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScannerContainer"] }]
}
