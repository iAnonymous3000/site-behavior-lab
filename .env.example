# Require a caller-provided key for /api/scan.
# Leave unset only for trusted local development or intentionally public deployments.
SITE_BEHAVIOR_LAB_SCAN_ACCESS_TOKEN=

# Containers front Worker only: a distinct operator credential for the hourly
# production synthetic scan. The reference deployment has this lane active. It
# bypasses Turnstile only for POST /api/scan, remains edge-only, and does not
# disable the public Turnstile path.
SITE_BEHAVIOR_LAB_SYNTHETIC_MONITOR_TOKEN=

# Dedicated R2 delete-canary Worker only. This is not a scanner/container secret.
# Configure it only through wrangler.r2-delete-canary.jsonc, use a value distinct
# from every production/staging credential, and pair it with the separately
# configured GitHub production-health secret. The reference canary is code-ready
# but not activated merely because this variable is documented.
SITE_BEHAVIOR_LAB_R2_DELETE_CANARY_TOKEN=

# Trust x-real-ip / x-forwarded-for only when a trusted proxy blocks direct origin access.
SITE_BEHAVIOR_LAB_TRUST_PROXY_HEADERS=0

# Chromium sandbox. Production sets 1. Requires unprivileged user namespaces on
# the host; after enabling, verify one deployed scan succeeds before relying on
# it (the scanner fails closed when the sandbox cannot start).
SITE_BEHAVIOR_LAB_CHROMIUM_SANDBOX=0

# Reviewed public egress label included in scan reports. The committed-r2
# workflow requires the private configuration alias controlled-self-hosted;
# reports emit the generic label and record the stable location below.
SITE_BEHAVIOR_LAB_SCANNER_EGRESS=this scanner instance

# Recorded egress region for r2 reports. Unset, the scanner falls back to the
# CLOUDFLARE_REGION/CLOUDFLARE_LOCATION/CLOUDFLARE_COUNTRY_A2 placement
# metadata Cloudflare Containers injects; with neither, the region stays
# unrecorded and r2 comparison deltas are refused (unknown never matches
# unknown). Declare it only when it truthfully names where scan traffic
# actually leaves from.
SITE_BEHAVIOR_LAB_SCANNER_EGRESS_REGION=

# Return 202 job submissions from /api/scan and poll /api/scans/:id.
# This is single-process, in-memory queueing for one Node instance.
SITE_BEHAVIOR_LAB_ASYNC_SCANS=0

# Durable execution remains a disabled production ship gate. Do not enable it
# directly in production: first deploy the exact reviewed SHA to the isolated,
# token-gated staging topology, pass both live replay canaries, and tear down all
# staging resources and credentials as required by docs/go-live-public-scanner.md.
SITE_BEHAVIOR_LAB_DURABLE_JOBS=0
# Worker-only AES-256-GCM key: exactly 32 random bytes encoded as unpadded
# base64url. Never forward this secret into the Node container.
SITE_BEHAVIOR_LAB_DURABLE_JOBS_KEY=
# Separate private coordinator credential. Configure it as a Worker secret; the
# Worker forwards only this credential into the Node container.
SITE_BEHAVIOR_LAB_DURABLE_JOBS_INTERNAL_TOKEN=
# Non-secret coordinator origin, forwarded into the Node container.
SITE_BEHAVIOR_LAB_DURABLE_JOBS_COORDINATOR_URL=https://scan.sitebehavior.org

# Post-durability scheduled-rescan gate. Public creation uses the ordinary
# Turnstile/scan-token gate plus atomic quota. The optional watch access token is
# a staging/operator second factor; leave it unset for the public browser UI.
# Every configured watch secret must be isolated and never forwarded into Node.
SITE_BEHAVIOR_LAB_ENCRYPTED_WATCHES=0
SITE_BEHAVIOR_LAB_ENCRYPTED_WATCHES_KEY=
SITE_BEHAVIOR_LAB_ENCRYPTED_WATCHES_PREVIOUS_KEY=
SITE_BEHAVIOR_LAB_ENCRYPTED_WATCHES_ACCESS_TOKEN=

# Report storage backend: "filesystem" (default) or "r2".
# "filesystem" needs a persistent volume to survive restarts; "r2" stores reports
# in Cloudflare R2 so share links survive container redeploys and host replacement
# (and is what multi-node hosting needs).
SITE_BEHAVIOR_LAB_REPORT_STORE_BACKEND=filesystem

# Filesystem backend: use a persistent volume in production.
SITE_BEHAVIOR_LAB_REPORT_STORE_DIR=/var/lib/site-behavior-lab/reports
SITE_BEHAVIOR_LAB_REPORT_MAX_AGE_DAYS=7
SITE_BEHAVIOR_LAB_REPORT_MAX_COUNT=500
# Keep a completed report recoverable throughout the 75-minute durable job TTL.
SITE_BEHAVIOR_LAB_REPORT_MIN_SURVIVAL_MS=4500000
# Whole publication/pruning deadline, including queue wait and physical deletes.
SITE_BEHAVIOR_LAB_REPORT_STORE_OPERATION_TIMEOUT_MS=30000

# R2 backend (S3-compatible), required when REPORT_STORE_BACKEND=r2 or the
# v2 shadow backend is r2.
# Endpoint looks like https://<accountid>.r2.cloudflarestorage.com
# Use an R2 API token scoped to the reports bucket (Object Read & Write).
SITE_BEHAVIOR_LAB_R2_BUCKET=site-behavior-lab-reports
SITE_BEHAVIOR_LAB_R2_ENDPOINT=
SITE_BEHAVIOR_LAB_R2_ACCESS_KEY_ID=
SITE_BEHAVIOR_LAB_R2_SECRET_ACCESS_KEY=
SITE_BEHAVIOR_LAB_R2_PREFIX=reports/

# Flag-gated ScanReport v2/r2 shadow evidence. Filesystem is the local default;
# Cloudflare Containers hardcodes the create-only R2 sink. R2 shadows reuse the
# credentials above under v2-shadow/<build>/<kind>/, never reports/. A prefix
# is not an ACL; keep r2.dev disabled and custom domains absent/Access-protected.
SITE_BEHAVIOR_LAB_CONSENT_VERIFICATION=0
# Public Node report generation: exact opt-in only. Enabling requires consent
# verification, a full SITE_BEHAVIOR_LAB_BUILD_COMMIT, and working persistence.
# Misconfiguration refuses scans; it never falls back to v1.
SITE_BEHAVIOR_LAB_PUBLIC_R2_REPORTS=0
SITE_BEHAVIOR_LAB_V2_SHADOW_EMISSION=0
SITE_BEHAVIOR_LAB_V2_SHADOW_BACKEND=filesystem
SITE_BEHAVIOR_LAB_V2_SHADOW_DIR=.site-behavior-lab/v2-shadow

# Canonical public HTTPS origin (scheme + host only) used at build time for
# canonicals, sitemap URLs, structured data, and social cards. Production
# builds fail closed when this is missing or invalid; only development falls
# back to http://localhost:3000.
NEXT_PUBLIC_SITE_BEHAVIOR_LAB_SITE_URL=

# Public evidence-library origin (scheme + host only) this deployment belongs
# to. The /status/ page fetches <origin>/deployment.json to compare the live
# site and scanner revisions, and report permalinks resolve there. Leave unset
# to use https://sitebehavior.org; a self-host that leaves the default will
# compare its own revision against that site and report "degraded" for an
# unrelated deploy. Inlined at build time, so a container needs it as a Docker
# build argument rather than a runtime variable.
NEXT_PUBLIC_SITE_BEHAVIOR_LAB_LIBRARY_ORIGIN=

# Cloudflare Worker ingress (wrangler.container.jsonc). Gated by default: set
# this to 1 only for an intentionally public deployment, and add WAF or another
# atomic cost control. The container scanner routes every request through its
# own connect-time IP-pinned proxy, so there is no preflight-only DNS gap to
# waive; the retired Browser Run risk flag was deleted with that worker.
SITE_BEHAVIOR_LAB_ALLOW_UNAUTHENTICATED_SCANS=0
# Open access enforces Turnstile whenever TURNSTILE_SECRET_KEY is set. If you open
# the scanner with NO Turnstile secret, the gate fails closed (503) unless you
# consciously waive it here, leaving only the atomic per-client quota the
# scanner Durable Object accounts in its own SQLite storage. No KV namespace is
# bound on any config in this repository.
SITE_BEHAVIOR_LAB_ACCEPT_NO_TURNSTILE_RISK=0
SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_MINUTE=6
SITE_BEHAVIOR_LAB_PUBLIC_SCAN_RATE_LIMIT_PER_DAY=120
# Gated deployments set these as Worker secrets against the explicit config:
#   wrangler secret put SITE_BEHAVIOR_LAB_SCAN_ACCESS_TOKEN -c wrangler.container.jsonc
# Production synthetic monitoring uses its own Worker-only secret:
#   wrangler secret put -c wrangler.container.jsonc SITE_BEHAVIOR_LAB_SYNTHETIC_MONITOR_TOKEN
# Turnstile is configured on the same explicit config:
#   wrangler secret put TURNSTILE_SECRET_KEY -c wrangler.container.jsonc
# When TURNSTILE_SECRET_KEY is set on the Worker, the static UI also needs the
# matching public Turnstile site key at build time, or scans will be blocked.
NEXT_PUBLIC_SITE_BEHAVIOR_LAB_TURNSTILE_SITE_KEY=
SITE_BEHAVIOR_LAB_ALLOWED_ORIGIN=*
